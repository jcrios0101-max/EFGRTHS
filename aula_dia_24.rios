      "cell_type": "code",
      "source": [
        "# Escrever um programa que recebe um numero e retorna somente os numeros pares\n",
        "\n",
        "#Entrada\n",
        "\n",
        "numero = int (input(\"digite um numero: \"))\n",
        "\n",
        "for i in range(numero + 1):\n",
        "  if i % 2==0:\n",
        "    print (i)"
      ],
