      "source": [
        "#tabuada 1 a 10\n",
        "\n",
        "numero = int (input(\"digite um numero: \"))\n",
        "\n",
        "if 1 <= numero <= 10:\n",
        "  print(f\"tabuada do {numero}:\")\n",
        "  for i in range(1, 11):\n",
        "    print(f\"{numero} x {i} = {numero * i}\")\n",
        "\n",
        "\n",
        "\n"
      ],
      "metadata": {
        "colab": {
