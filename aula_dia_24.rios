      "source": [
        "palavra = str (input(\"digite uma palavra: \"))\n",
        "palindromo = \"\"\n",
        "\n",
        "for i in (palavra):\n",
        "  palindromo = i + palindromo\n",
        "print(palindromo)"
      ],
